adjust-cursor-height = 40%
cursor-text = 181926
adjust-cell-height = 10%
window-padding-x = 8
window-padding-y = 8
mouse-hide-while-typing = true
font-family = Menlo
#font-size = 12
theme = Github Dark Colorblind
mouse-scroll-multiplier = 2
split-divider-color = yellow
shell-integration = fish
auto-update-channel = tip
window-inherit-working-directory = false
tab-inherit-working-directory = false
split-inherit-working-directory = true

custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl

# Karabiner Caps Lock (Hyper) + O opens the Herdr agent chooser.
keybind = super+ctrl+alt+shift+o=text:\x02\x0f

# Karabiner Caps Lock (Hyper) + U opens URLs from the focused Herdr pane.
keybind = super+ctrl+alt+shift+u=text:\x02O
